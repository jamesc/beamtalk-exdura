/// Serialized snapshot of workflow replay state at a specific event.
///
/// Written to disk as ETF by EventStore saveSnapshot: and deserialized
/// by readEventsFromSnapshot:. Pairs a ReplaySnapshot with the eventId
/// at which it was captured.
///
/// ## Examples
/// ```beamtalk
/// StoredSnapshot new: #{
///   #state => (ReplaySnapshot new: #{#replayCursor => 50}),
///   #eventId => 51
/// }
/// ```
typed Value subclass: StoredSnapshot
  field: state :: ReplaySnapshot
  field: eventId :: Integer = 0

  /// Deserialize an ETF-encoded binary into a StoredSnapshot.
  ///
  /// Checks the Dynamic return of `Binary deserialize:` at a single
  /// well-named boundary so callers can work in typed code. Signals an
  /// Error if the binary does not decode to a StoredSnapshot.
  class fromBinary: content :: Binary -> StoredSnapshot =>
    result := Binary deserialize: content
    (result isKindOf: StoredSnapshot) ifFalse: [
      Error signal: "snapshot binary does not contain a StoredSnapshot"
    ]
    result
