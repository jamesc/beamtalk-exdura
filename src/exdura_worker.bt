/// Convenience entry point for booting the Exdura workflow engine.
///
/// Starts ExduraSupervisor, wires children together, applies
/// configuration, and returns a connected ExduraClient.
///
/// ## Examples
/// ```beamtalk
/// client := ExduraWorker start: #{#maxConcurrentActivities => 20}
/// handle := client start: OrderWorkflow id: "order-1"
///   args: #("data") taskQueue: "orders" options: #{}
/// result := handle result
/// ```
///
/// ## Optional HTTP client API (SPEC.md §7.2)
///
/// Pass `#http` to also start a REST/JSON API for non-Beamtalk clients.
/// `#workflows` lists every `Workflow` subclass startable by name over
/// HTTP (`POST /api/v1/workflows` with a `workflowType` field).
///
/// ```beamtalk
/// client := ExduraWorker start: #{
///   #workflows => #(OrderWorkflow, ApprovalWorkflow),
///   #http => #{#port => 4100}
/// }
/// client httpServer port   // => 4100
/// ```
typed Object subclass: ExduraWorker

  /// Boot the supervision tree and return a connected ExduraClient.
  ///
  /// ## Examples
  /// ```beamtalk
  /// client := ExduraWorker start: #{#maxConcurrentActivities => 20}
  /// ```
  class start: config :: Dictionary -> ExduraClient =>
    sup := ExduraSupervisor supervise valueOrDo: [:e |
      self error: "Failed to start ExduraSupervisor: {e}"
    ]

    // Sibling wiring is handled by ExduraSupervisor class initialize:.
    // sup which: is typed -> Result(Object, Error); typing the local asserts
    // the concrete class so downstream method sends type-check cleanly.
    engine :: WorkflowEngine := (sup which: WorkflowEngine) valueOrDo: [:e |
      self error: "WorkflowEngine not found under ExduraSupervisor: {e}"
    ]
    store :: EventStore := (sup which: EventStore) valueOrDo: [:e |
      self error: "EventStore not found under ExduraSupervisor: {e}"
    ]
    pool :: ActivityWorkerPool := (sup which: ActivityWorkerPool) valueOrDo: [:e |
      self error: "ActivityWorkerPool not found under ExduraSupervisor: {e}"
    ]

    // Apply config
    maxActivities := config at: #maxConcurrentActivities ifAbsent: [10]
    pool setMaxConcurrent: maxActivities

    // Create client connected to the supervised engine
    client := ExduraClient spawnWith: #{#engine => engine, #eventStore => store}
    client setSupervisor: sup

    // Optional HTTP client API (SPEC.md §7.2). ExduraHttpServer is always a
    // static child of ExduraSupervisor, started (but not yet listening) as
    // part of `ExduraSupervisor supervise` above — before this method ever
    // sees `#http` config. Durably recording the config on EventStore and
    // triggering `refreshFromDurableConfig` here is what makes it actually bind; from
    // then on, ExduraHttpServer's own `initialize` re-reads that same
    // config and re-binds on every future restart with no further help
    // from this method (see ExduraHttpServer>>startListening).
    httpConfig := config at: #http ifAbsent: [nil]
    httpConfig
      ifNotNil: [
        port := httpConfig at: #port ifAbsent: [4100]
        workflowClasses := config at: #workflows ifAbsent: [#()]
        // Durable config stores class NAMES (Symbols), never class objects
        // directly — see ExduraHttpServer>>resolveWorkflowClassNames:'s doc
        // for why (a Beamtalk class is itself a live actor process, not
        // serializable data).
        store
          setHttpConfig: #{
            #port => port,
            #workflowClasses => (workflowClasses collect: [:wc | wc name])
          }
        http :: ExduraHttpServer := (sup which: ExduraHttpServer) valueOrDo: [:e |
          self error: "ExduraHttpServer not found under ExduraSupervisor: {e}"
        ]
        http refreshFromDurableConfig
        client setHttpServer: http
      ]

    client
