/// Public API facade for interacting with Exdura workflows.
///
/// ExduraClient wraps a WorkflowEngine and provides a clean interface for
/// starting workflows, waiting for results, and listing executions. Phase 1
/// operates in-process only; connection options are accepted but ignored.
///
/// ExduraClient is an Actor to hold mutable references to the engine and
/// event store. All method calls are synchronous gen_server calls.
///
/// ## Examples
/// ```beamtalk
/// client := ExduraClient connect: #{}
/// handle := client start: OrderWorkflow id: "order-1"
///   args: #("data") taskQueue: "orders" options: #{}
/// result := handle result
///
/// // List running workflows
/// running := client list: #{#status => #running}
/// ```
typed Actor subclass: ExduraClient
  state: engine :: WorkflowEngine
  state: eventStore :: EventStore
  state: supervisor :: Supervisor | Nil = nil
  state: httpServer :: ExduraHttpServer | Nil = nil

  /// Create a client connected to an in-process workflow engine.
  ///
  /// In Phase 1, options are accepted but ignored — the client creates
  /// a local EventStore and WorkflowEngine. Future phases will support
  /// remote connections.
  ///
  /// ## Examples
  /// ```beamtalk
  /// client := ExduraClient connect: #{#host => "localhost"}
  /// ```
  class connect: options :: Dictionary -> ExduraClient =>
    dataDir := options at: #dataDir ifAbsent: ["data"]
    store := EventStore spawnWith: #{#dataDir => dataDir}
    usePool := options at: #pool ifAbsent: [true]
    pool := usePool ifTrue: [ActivityWorkerPool spawn] ifFalse: [nil]
    eng := WorkflowEngine withStore: store pool: pool
    self spawnWith: #{#engine => eng, #eventStore => store}

  /// Start a workflow and return a WorkflowHandle.
  ///
  /// The workflow begins executing asynchronously. Use the returned
  /// handle to wait for the result.
  ///
  /// ## Examples
  /// ```beamtalk
  /// handle := client start: OrderWorkflow id: "order-1"
  ///   args: #("data") taskQueue: "orders" options: #{}
  /// result := handle result
  /// ```
  start: workflowClass :: Workflow class id: workflowId :: String args: args :: List taskQueue: _queueName :: String options: _options :: Dictionary -> WorkflowHandle =>
    self.engine
      startWorkflow: workflowClass
      id: workflowId
      args: args
    WorkflowHandle for: workflowId client: self

  /// Send a signal to a running workflow.
  ///
  /// Records a SignalReceived event in the workflow's history and buffers
  /// the signal in the engine. The signal will be delivered to the workflow
  /// at the next safe point (after the current command completes).
  ///
  /// ## Examples
  /// ```beamtalk
  /// client signal: "wf-1" name: "approve" payload: #{#user => "alice"}
  /// ```
  signal: workflowId :: String name: signalName :: String payload: data :: Object -> Nil =>
    self.engine
      bufferSignal: workflowId
      name: signalName
      payload: data

  /// Query a running workflow's state via a registered query handler.
  ///
  /// Evaluates the named query handler against the workflow's cached
  /// snapshot (captured at the last safe point). Returns the handler's
  /// result. Raises an error if no handler or snapshot exists.
  ///
  /// ## Examples
  /// ```beamtalk
  /// status := client query: "wf-1" name: "getStatus"
  /// ```
  query: workflowId :: String name: queryName :: String -> Object =>
    self.engine handleQuery: workflowId name: queryName

  /// Cancel a running workflow.
  ///
  /// Records a WorkflowCancelled event in the workflow's history,
  /// sets a cancellation flag that causes the WorkflowContext to raise
  /// CancellationError at the next safe point, and cancels child workflows
  /// per their parent-close policy.
  ///
  /// Workflows can catch CancellationError with `on:do:` for cleanup.
  ///
  /// ## Examples
  /// ```beamtalk
  /// client cancel: "wf-1"
  /// ```
  cancel: workflowId :: String -> Nil => self.engine cancelWorkflow: workflowId

  /// List workflow executions matching a filter.
  ///
  /// Supported filter keys: #status (Symbol), #workflowType (String).
  /// Pass an empty dictionary to list all executions.
  ///
  /// ## Examples
  /// ```beamtalk
  /// client list: #{#status => #running}
  /// client list: #{}   // all executions
  /// ```
  list: filter :: Dictionary -> List => self.eventStore listExecutions: filter

  /// Retrieve a workflow execution by ID (used by WorkflowHandle).
  ///
  /// ## Examples
  /// ```beamtalk
  /// client getExecution: "wf-1"
  /// ```
  getExecution: workflowId :: String -> WorkflowExecution | Nil =>
    self.eventStore getExecution: workflowId

  /// Return the underlying WorkflowEngine (for testing/inspection).
  engine -> WorkflowEngine => self.engine

  /// Return the underlying EventStore (for testing/inspection).
  eventStore -> EventStore => self.eventStore

  /// Return the underlying Supervisor (for testing/lifecycle management).
  supervisor -> Supervisor | Nil => self.supervisor

  /// Set the supervisor that manages this client's components.
  ///
  /// Called by ExduraWorker to attach the supervision tree reference,
  /// enabling proper cleanup via destroy.
  ///
  /// ## Examples
  /// ```beamtalk
  /// client setSupervisor: sup
  /// ```
  setSupervisor: sup :: Supervisor -> Nil =>
    self.supervisor := sup
    nil

  /// Return the optional HTTP client API server (nil unless ExduraWorker
  /// was started with an `#http` config). Read-only: it's a genuine
  /// `ExduraHttpServerSupervisor`-supervised child now, so lifecycle
  /// (including shutdown, via `destroy`'s `sup stop`) is the supervisor's
  /// job, not the client's — this accessor exists for inspection (e.g.
  /// reading the bound port after starting on an ephemeral `0`).
  httpServer -> ExduraHttpServer | Nil => self.httpServer

  /// Attach the optional HTTP client API server reference for inspection.
  ///
  /// Called by ExduraWorker when `#http` config starts one.
  ///
  /// ## Examples
  /// ```beamtalk
  /// client setHttpServer: http
  /// ```
  setHttpServer: http :: ExduraHttpServer -> Nil =>
    self.httpServer := http
    nil

  /// Clean up resources (EventStore ETS tables, worker pool, supervisor).
  ///
  /// If a supervisor is attached (ExduraWorker-managed), stops it which
  /// terminates all supervised children — including the HTTP server, if
  /// one was started. Otherwise cleans up components individually
  /// (ExduraClient connect:-managed, which never has an HTTP server).
  ///
  ///   client destroy
  destroy -> Nil =>
    self.supervisor match: [
      nil -> nil;
      // Supervisor-managed: stop supervisor first (terminates all children),
      // then clean up files. Order matters: destroyWithFiles would crash the
      // EventStore, triggering a supervisor restart before we stop it.
      sup -> ^sup stop
    ]
    // Non-supervised: clean up components individually
    poolResult := Result tryDo: [self.engine activityPool]
    poolResult isOk
      ifTrue: [
        p := poolResult unwrap
        Result tryDo: [p destroy]
      ]
    [self.engine stop] on: Error do: [:e | nil]
    [self.eventStore destroyWithFiles] on: Error do: [:e | nil]
    [self.eventStore stop] on: Error do: [:e | nil]
