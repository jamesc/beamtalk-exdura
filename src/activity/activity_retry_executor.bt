/// Executes an activity with exponential backoff retry logic (BT-1494).
///
/// A plain Object (not Actor) that handles retry loops for activity execution.
/// Uses Result tryDo: for exception capture.
///
/// ## Examples
/// ```beamtalk
/// result := ActivityRetryExecutor
///   execute: TestActivities selector: #doWork: args: #(data)
///   eventStore: store workflowId: "wf-1"
///   retryPolicy: (RetryPolicy new: #{#maximumAttempts => 3})
/// ```
Object subclass: ActivityRetryExecutor

  /// Execute an activity with retry policy, recording events.
  class execute: activityClass :: Activity class selector: selector :: Symbol args: args :: List eventStore: eventStore :: EventStore workflowId: workflowId :: String retryPolicy: rp :: RetryPolicy -> Object =>
    config := ActivityRetryConfig
      new: #{
        #activity => activityClass,
        #selector => selector,
        #args => args,
        #eventStore => eventStore,
        #workflowId => workflowId,
        #maxAttempts => rp maximumAttempts,
        #initialInterval => rp initialInterval,
        #backoffCoefficient => rp backoffCoefficient,
        #maximumInterval => rp maximumInterval,
        #nonRetryableErrors => rp nonRetryableErrors
      }
    self runWithRetry: config

  /// Retry loop: attempt one execution per iteration.
  ///
  /// On success, records ActivityCompleted and returns the result.
  /// On non-retryable error or exhausted retries, records ActivityFailed
  /// and raises. Otherwise, sleeps with backoff and tries again.
  class runWithRetry: config :: ActivityRetryConfig -> Object =>
    attempt := 1
    [true]
      whileTrue: [
        outcome := Result tryDo: [
          config activity perform: config selector withArguments: #(config args)
        ]
        // Success — record ActivityCompleted and return
        outcome ok
          ifTrue: [
            completedEvent := ExduraEvent
              new: #{
                #eventType => #ActivityCompleted,
                #timestamp => Time nowMs div: 1000,
                #payload => #{#result => outcome value}
              }
            config eventStore appendEvents: config workflowId events: #(completedEvent)
            ^outcome value
          ]
        // Failure — extract error details
        err := outcome error
        errMsg := err message
        errClass := err class name asString
        failure :: Dictionary(Symbol, JsonValue) := #{
          #error => errMsg,
          #errorClass => errClass,
          #attempt => attempt
        }
        (config nonRetryableErrors anySatisfy: [:nr | nr == errClass])
          ifTrue: [
            ^self recordFailedAndRaise: config payload: (failure at: #nonRetryable put: true)
          ]
        // Check retry exhaustion (0 or nil means unlimited per SPEC §4.1.4)
        (self retriesExhausted: attempt config: config)
          ifTrue: [
            ^self recordFailedAndRaise: config payload: (failure at: #retriesExhausted put: true)
          ]
        Timer sleep: (self backoffFor: attempt config: config)
        attempt := attempt + 1
      ]

  /// Backoff before the next attempt: exponential, capped at maximumInterval.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cfg := ActivityRetryConfig new: #{#initialInterval => 100, #backoffCoefficient => 2}
  /// ActivityRetryExecutor backoffFor: 3 config: cfg   // => 400
  /// ```
  class backoffFor: attempt :: Integer config: config :: ActivityRetryConfig -> Integer =>
    delay := (config initialInterval * (config backoffCoefficient raisedTo: attempt - 1)) ceiling
    config maximumInterval ifNil: [
      delay
    ] ifNotNil: [:maxInterval | delay min: maxInterval]

  /// Record an ActivityFailed event for `config`'s workflow and raise the
  /// error message.
  class recordFailedAndRaise: config :: ActivityRetryConfig payload: payload :: Dictionary(Symbol, JsonValue) =>
    failedEvent := ExduraEvent
      new: #{
        #eventType => #ActivityFailed,
        #timestamp => Time nowMs div: 1000,
        #payload => payload
      }
    config eventStore appendEvents: config workflowId events: #(failedEvent)
    self error: (payload at: #error)

  /// True when `attempt` has reached the configured retry limit.
  /// Returns false when maxAttempts is nil or 0 (unlimited per SPEC §4.1.4).
  ///
  /// ## Examples
  /// ```beamtalk
  /// cfg := ActivityRetryConfig new: #{#maxAttempts => 3}
  /// ActivityRetryExecutor retriesExhausted: 2 config: cfg   // => false
  /// ActivityRetryExecutor retriesExhausted: 3 config: cfg   // => true
  /// unlimited := ActivityRetryConfig new: #{#maxAttempts => 0}
  /// ActivityRetryExecutor retriesExhausted: 99 config: unlimited   // => false
  /// ```
  class retriesExhausted: attempt :: Integer config: config :: ActivityRetryConfig -> Boolean =>
    config maxAttempts match: [
      nil -> false;
      n :: Integer when: [n <= 0] -> false;
      n :: Integer -> attempt >= n
    ]
