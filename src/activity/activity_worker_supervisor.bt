/// DynamicSupervisor for ActivityWorker child processes (BT-1495).
///
/// Manages supervised ActivityWorker actors. Workers that crash are
/// automatically cleaned up by the supervisor without affecting other
/// workers or the parent pool.
///
/// Each ActivityWorkerPool spawns its own instance with `spawnWith:`
/// (ADR 0135), so restart limits are per pool. A pool can override them
/// with the `#maxRestarts` / `#restartWindow` start args.
///
/// ## Examples
/// ```beamtalk
/// sup := ActivityWorkerSupervisor spawnWith: #{#maxRestarts => 3}
/// worker := sup startChild
/// worker initWith: MyAct selector: #go: args: #(1)
/// sup count   // => 1
/// ```
DynamicSupervisor subclass: ActivityWorkerSupervisor

  childClass => ActivityWorker

  /// Restarts allowed within `restartWindow` before this pool's
  /// supervisor gives up. Start arg `#maxRestarts`, default 10.
  maxRestarts -> Integer => self args at: #maxRestarts ifAbsent: [10]

  /// Window in seconds for `maxRestarts`. Start arg `#restartWindow`,
  /// default 60.
  restartWindow -> Integer => self args at: #restartWindow ifAbsent: [60]
