/// Supervised worker pool for activity execution (BT-1495).
///
/// ActivityWorkerPool manages ActivityWorker child processes under a
/// DynamicSupervisor (ActivityWorkerSupervisor). It enforces a
/// maxConcurrentActivities limit, provides timeout enforcement via Timer,
/// and catches worker crashes.
///
/// Each pool spawns its own ActivityWorkerSupervisor (ADR 0135), so one
/// pool's supervisor giving up never affects another pool. The pool stops
/// its supervisor when it terminates. Pass `#supervisorArgs` to override
/// the supervisor's restart limits.
///
/// The pool exposes a synchronous executeActivity: interface that spawns
/// a supervised worker, executes the activity, and returns a result
/// dictionary describing the outcome.
///
/// ## Examples
/// ```beamtalk
/// pool := ActivityWorkerPool spawn
/// pool setMaxConcurrent: 5
/// strict := ActivityWorkerPool spawnWith: #{#supervisorArgs => #{#maxRestarts => 3}}
/// result := pool executeActivity: TestActivities selector: #doubleIt:
///   args: #(5) timeout: nil
/// // => #{#status => #completed, #result => 10}
/// ```
typed Actor subclass: ActivityWorkerPool
  state: maxConcurrent :: Integer = 10
  state: activeCount :: Integer = 0
  state: supervisorArgs :: Dictionary = #{}
  state: supervisor :: ActivityWorkerSupervisor

  /// Initialize the pool by spawning its own DynamicSupervisor.
  initialize -> Nil =>
    self.supervisor := ActivityWorkerSupervisor spawnWith: self.supervisorArgs
    nil

  /// Stop this pool's supervisor (and its workers) with the pool. The
  /// supervisor is spawned unlinked, so nothing else would stop it.
  terminate: _reason :: Object -> Nil =>
    [self.supervisor stop] on: Error do: [:e | nil]
    nil

  /// Return this pool's ActivityWorkerSupervisor (for testing/inspection).
  ///
  /// ## Examples
  /// ```beamtalk
  /// pool supervisor count   // => 0
  /// ```
  supervisor -> ActivityWorkerSupervisor => self.supervisor

  /// Set the maximum number of concurrent activity workers.
  ///
  /// ## Examples
  /// ```beamtalk
  /// pool setMaxConcurrent: 20
  /// ```
  setMaxConcurrent: max :: Integer -> Nil =>
    self.maxConcurrent := max
    nil

  /// Return the maximum concurrent activities allowed.
  ///
  /// ## Examples
  /// ```beamtalk
  /// pool maxConcurrent   // => 10
  /// ```
  maxConcurrent -> Integer => self.maxConcurrent

  /// Return the current number of active workers.
  ///
  /// ## Examples
  /// ```beamtalk
  /// pool activeCount   // => 3
  /// ```
  activeCount -> Integer => self.activeCount

  /// Execute an activity through the supervised worker pool.
  ///
  /// Spawns an ActivityWorker under the DynamicSupervisor, executes the
  /// activity class method, and enforces startToCloseTimeout if set.
  /// All logic is inlined to avoid self-send deadlocks (Actor methods
  /// are gen_server handlers — calling self blocks).
  ///
  /// Returns an ActivityOutcome describing the result:
  ///
  /// ## Examples
  /// ```beamtalk
  /// ActivityOutcome completed: 42
  /// ActivityOutcome failed: "division by zero"
  /// ActivityOutcome timedOut
  /// ActivityOutcome rejected
  ///
  /// pool executeActivity: TestActivities selector: #doubleIt:
  ///   args: #(5) timeout: nil
  /// ```
  executeActivity: activityClass :: Activity class selector: selector :: Symbol args: args :: List timeout: timeout :: Integer | Nil -> ActivityOutcome =>
    // Enforce concurrency limit
    self.activeCount >= self.maxConcurrent ifTrue: [^ActivityOutcome rejected]
    self.activeCount := self.activeCount + 1
    // Spawn supervised worker and initialize it. If the supervisor refuses
    // (e.g. max_children reached), undo the active-count increment and
    // surface the failure as a rejection. Mutating Actor state inside a
    // closure is disallowed, so check the Result out-of-line.
    startResult := self.supervisor startChild
    startResult isError
      ifTrue: [
        self.activeCount := self.activeCount - 1
        ^ActivityOutcome rejected
      ]
    worker := startResult unwrap
    worker
      initWith: activityClass
      selector: selector
      args: args
    // Set up timeout: kill worker process after timeout ms. Uses Pid kill to
    // force immediate process termination, which causes the pending
    // gen_server call to fail instantly. When timeout is nil, a NullTimer
    // stands in so downstream code can treat both cases uniformly.
    timer := self killTimerFor: worker timeout: timeout
    // Execute the activity in the worker's process.
    // The exception handler returns early (^) from the method so that the
    // success path can unconditionally wrap the result. This avoids the
    // previous bug where an activity returning a Dictionary with a #status
    // key (e.g. #{#status => "reserved"}) was misidentified as a pool
    // error outcome.
    // Capture state before cancel: cancel deactivates the timer, so
    // isActive must be read first (inside the handler) to distinguish a
    // timeout-kill from a pre-timeout crash. NullTimer stays active.
    firedByTimeout := false
    outcome := [worker execute]
      on: Exception
      do: [:e |
        firedByTimeout := timer isActive not
        timer cancel
        self.activeCount := self.activeCount - 1
        // Worker survives a caught activity crash (safe_dispatch returns it
        // as a normal reply) — stop it so it doesn't leak as a permanent
        // child of this pool's ActivityWorkerSupervisor. A
        // timeout-killed worker is already dead; stop then just no-ops/errors.
        [worker stop] on: Error do: [:e2 | nil]
        firedByTimeout ifTrue: [
          ^ActivityOutcome timedOut
        ] ifFalse: [^ActivityOutcome failed: e message]
      ]
    // Success: wrap result unconditionally
    self.activeCount := self.activeCount - 1
    timer cancel
    // One-shot worker: stop it now rather than leaking it as a permanent
    // child of this pool's ActivityWorkerSupervisor (BT-1495 pool docs).
    // Left running, these accumulate across every activity dispatch and can
    // starve later dispatches through the same supervisor.
    [worker stop] on: Error do: [:e2 | nil]
    ActivityOutcome completed: outcome

  /// Build a TimeoutToken that kills `worker` after `ms` milliseconds.
  /// Returns a NullTimer when `ms` is nil (no timeout configured).
  killTimerFor: worker :: ActivityWorker timeout: ms :: Integer | Nil -> TimeoutToken =>
    ms match: [
      nil -> NullTimer new;
      t :: Integer -> Timer after: t do: [worker kill]
    ]

  /// Clean up the pool. The pool's own supervisor is stopped when the
  /// pool stops (see `terminate:`).
  ///
  ///   pool destroy
  destroy -> Nil => nil
