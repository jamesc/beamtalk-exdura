/// Manages pending durable timers and re-arms them on startup.
///
/// TimerManager scans workflow event histories for unresolved timers
/// (TimerStarted without a matching TimerFired) and reconstructs them
/// via the WorkflowEngine. This ensures timers survive process restarts.
///
/// ## Examples
/// ```beamtalk
/// manager := TimerManager spawnWith: #{#engine => engine, #eventStore => store}
/// manager reconstructPendingTimers: #("wf-1", "wf-2")
/// ```
typed Actor subclass: TimerManager
  /// nil only for a supervised TimerManager — the `ExduraSupervisor` child
  /// spec registers `WorkflowEngine`/`EventStore` under fixed names
  /// (ADR 0079) instead of passing live refs, since neither exists yet
  /// when the child spec is built. `engine`/`eventStore` below resolve
  /// fresh by name in that case, so a `rest_for_one` restart of either is
  /// picked up automatically instead of leaving a nil/stale field.
  state: engine :: WorkflowEngine | Nil = nil
  state: eventStore :: EventStore | Nil = nil
  state: status :: Symbol = #ready
  state: pendingCount :: Integer = 0

  /// Find unresolved timers in an event history.
  ///
  /// Returns a list of dictionaries with #duration and #fireAt for each
  /// TimerStarted event that has no matching TimerFired.
  ///
  /// ## Examples
  /// ```beamtalk
  /// TimerManager findPendingTimers: events
  /// // => #(#{#duration => 5000, #fireAt => 1710000005000})
  /// ```
  class findPendingTimers: events :: List(ExduraEvent) -> List(TimerInfo) =>
    // Count TimerStarted and TimerFired events.
    // If started > fired, the last (started - fired) timers are pending.
    counts := events
      inject: #{#started => 0, #fired => 0}
      into: [:acc :evt |
        evt eventType match: [
          #TimerStarted -> #{
            #started => (acc at: #started) + 1,
            #fired => (acc at: #fired)
          };
          #TimerFired -> #{
            #started => (acc at: #started),
            #fired => (acc at: #fired) + 1
          };
          _ -> acc
        ]
      ]
    startedCount := counts at: #started
    firedCount := counts at: #fired
    pendingCount := startedCount - firedCount
    pendingCount <= 0 ifTrue: [^#()]
    // Collect all TimerStarted events, take the last pendingCount.
    // Then extract timer info from each pending event.
    started := events select: [:e | e eventType =:= #TimerStarted]
    diff := started size - pendingCount
    dropCount := diff > 0 ifTrue: [diff] ifFalse: [0]
    (started drop: dropCount)
      collect: [:e |
        p := e payload
        durDefault := 0
        dur := (p at: #duration ifAbsent: [durDefault]) match: [
          d :: Integer -> d;
          _ -> durDefault
        ]
        fireAtDefault := e timestamp + dur
        fireAt := (p at: #fireAt ifAbsent: [fireAtDefault]) match: [
          f :: Integer -> f;
          _ -> fireAtDefault
        ]
        TimerInfo new: #{#duration => dur, #fireAt => fireAt}
      ]

  /// Return the current status of the timer manager.
  ///
  /// ## Examples
  /// ```beamtalk
  /// manager status   // => #ready
  /// ```
  status -> Symbol => self.status

  /// Return the number of timers currently pending reconstruction.
  ///
  /// ## Examples
  /// ```beamtalk
  /// manager pendingCount   // => 0
  /// ```
  pendingCount -> Integer => self.pendingCount

  /// The WorkflowEngine to use — resolves by name (ADR 0079) when
  /// supervised and not yet cached; see the class doc comment.
  engine -> WorkflowEngine =>
    self.engine match: [
      nil -> (WorkflowEngine named: #workflowEngine) unwrap;
      e -> e
    ]

  /// The EventStore to use — resolves by name (ADR 0079) when supervised
  /// and not yet cached; see the class doc comment.
  eventStore -> EventStore =>
    self.eventStore match: [
      nil -> (EventStore named: #eventStore) unwrap;
      s -> s
    ]

  /// Scan event histories for unresolved timers and reconstruct them.
  ///
  /// For each workflow ID, reads the event history and checks for
  /// TimerStarted events that lack a corresponding TimerFired.
  /// Unresolved timers are re-armed via the engine's reconstructTimer
  /// method.
  ///
  /// ## Examples
  /// ```beamtalk
  /// manager reconstructPendingTimers: #("wf-1", "wf-2")
  /// // => 1  (number of timers reconstructed)
  /// ```
  reconstructPendingTimers: workflowIds :: List(String) -> Integer =>
    self.status := #scanning
    store := self eventStore
    engine := self engine
    count := workflowIds
      inject: 0
      into: [:acc :wfId |
        pending := TimerManager findPendingTimers: (store readEvents: wfId fromSeq: 1)
        pending
          do: [:timerInfo |
            remaining := engine
              reconstructTimer: timerInfo duration
              fireAt: timerInfo fireAt
              workflowId: wfId
            remaining > 0 ifTrue: [Timer sleep: remaining]
            engine recordTimerFired: timerInfo duration workflowId: wfId
          ]
        acc + pending size
      ]
    self.pendingCount := count
    self.status := #ready
    count
