/// BT-1499: BUnit tests for ExduraSupervisor and ExduraWorker.
///
/// Tests the supervision tree structure, rest_for_one strategy, and the
/// full ExduraWorker start: flow including running workflows through
/// the client.
TestCase subclass: ExduraSupervisorTest
  field: client = nil

  /// EventStore/WorkflowEngine register under fixed names (ADR 0079) while
  /// supervised — only one ExduraSupervisor may be alive at a time per
  /// node, so this class can't run concurrently with another that also
  /// spawns one.
  class serial -> Boolean => true

  setUp => self

  tearDown =>
    self.client isNil
      ifFalse: [
        [self.client destroy] on: Error do: [:e | nil]
        [self.client stop] on: Error do: [:e | nil]
      ]
    self.client := nil

  // ── Helpers ──

  /// Wait for a workflow to reach a terminal status (completed/failed/cancelled).
  /// Polls every 50ms up to the given timeout in milliseconds.
  awaitWorkflow: workflowId :: String timeout: timeoutMs :: Integer -> WorkflowExecution =>
    deadline := Time nowMs + timeoutMs
    [true]
      whileTrue: [
        exec := self.client eventStore getExecution: workflowId
        (exec isNil not
          and: [
            exec status =:= #completed or: [
              exec status =:= #failed or: [exec status =:= #cancelled]
            ]
          ]) ifTrue: [^exec]
        Time nowMs >= deadline ifTrue: [
          self error: "Timed out waiting for {workflowId}"
        ]
        Timer sleep: 50
      ]
    self error: "unreachable"

  // === ExduraSupervisor class-side config ===
  testSupervisorStrategyIsRestForOne =>
    self assert: ExduraSupervisor strategy equals: #restForOne

  // === ExduraWorker boots supervision tree and runs workflows ===
  testWorkerBootsAndRunsWorkflows =>
    // Start worker with custom config
    self.client := ExduraWorker start: #{#maxConcurrentActivities => 25}
    self assert: self.client notNil
    self assert: self.client engine notNil
    self assert: self.client eventStore notNil

    // Verify the supervisor started all 5 children (the 4 core components
    // plus the always-present, childless-by-default ExduraHttpServerSupervisor)
    sup := self.client supervisor
    self assert: sup notNil
    self assert: sup count equals: 5
    self assert: (sup which: EventStore) isOk
    self assert: (sup which: ActivityWorkerPool) isOk
    self assert: (sup which: WorkflowEngine) isOk
    self assert: (sup which: TimerManager) isOk
    self assert: (sup which: ExduraHttpServerSupervisor) isOk

    // Verify config was applied to the pool
    pool := self.client engine activityPool
    self assert: pool maxConcurrent equals: 25

    // Run a simple passthrough workflow through the supervised engine
    wfId1 := "sup-wf-1-" ++ Time nowMs asString
    handle := self.client
      start: PassthroughWorkflow
      id: wfId1
      args: #("supervised")
      taskQueue: "default"
      options: #{}
    result := handle result: 5000
    self assert: result equals: "supervised"

    // Run a two-activity workflow through the supervised engine
    wfId2 := "sup-wf-2-" ++ Time nowMs asString
    self.client
      start: TwoActivityWorkflow
      id: wfId2
      args: #(5)
      taskQueue: "default"
      options: #{}
    exec := self awaitWorkflow: wfId2 timeout: 10000
    self assert: exec notNil
    self assert: exec result equals: 20

  // === A rest_for_one cascade restart leaves WorkflowEngine/TimerManager/
  // ActivityWorkerPool functional, not wired to nil/dead refs ===
  //
  // Regression test: WorkflowEngine/TimerManager used to be wired up once
  // via `ExduraSupervisor class initialize:`, which only runs at the
  // initial `supervise` call — not on OTP-driven restarts. A restarted
  // WorkflowEngine came back with a nil eventStore and crashed on the next
  // workflow call. Fixed by having WorkflowEngine/TimerManager resolve
  // EventStore/WorkflowEngine/ActivityWorkerPool by name (ADR 0079) at
  // use-time instead of caching a pid.
  testEngineSurvivesEventStoreCrashCascade =>
    self.client := ExduraWorker start: #{}
    sup := self.client supervisor

    storeBefore := (sup which: EventStore) unwrap
    engineBefore := (sup which: WorkflowEngine) unwrap
    poolBefore := (sup which: ActivityWorkerPool) unwrap
    timerBefore := (sup which: TimerManager) unwrap

    // Force-crash EventStore; rest_for_one restarts everything after it.
    (Erlang erlang) exit: storeBefore pid reason: #kill
    Timer sleep: 300

    // Confirm the cascade actually restarted the downstream children —
    // otherwise this test would trivially pass without exercising anything.
    self assert: (storeBefore pid =:= (sup which: EventStore) unwrap pid) equals: false
    self assert: (engineBefore pid =:= (sup which: WorkflowEngine) unwrap pid) equals: false
    self assert: (poolBefore pid =:= (sup which: ActivityWorkerPool) unwrap pid) equals: false
    self assert: (timerBefore pid =:= (sup which: TimerManager) unwrap pid) equals: false

    // A workflow using an activity (exercises WorkflowEngine's EventStore
    // and ActivityWorkerPool) must still complete after the restart.
    wfId := "cascade-restart-" ++ Time nowMs asString
    self.client
      start: TwoActivityWorkflow
      id: wfId
      args: #(5)
      taskQueue: "default"
      options: #{}
    exec := self awaitWorkflow: wfId timeout: 10000
    self assert: exec notNil
    self assert: exec result equals: 20

    // TimerManager (resolves engine/eventStore by name) must still work.
    (sup which: TimerManager) unwrap reconstructPendingTimers: #()

  // === ExduraWorker starts a real, supervised ExduraHttpServer when #http is configured ===
  testWorkerStartsSupervisedHttpServer =>
    self.client := ExduraWorker start: #{
      #workflows => #(PassthroughWorkflow),
      #http => #{#port => 0}
    }
    http := self.client httpServer
    self assert: http notNil
    self assert: http port > 0

    // It's a genuine ExduraHttpServerSupervisor child, not a bare sibling actor.
    sup := self.client supervisor
    httpSup :: ExduraHttpServerSupervisor := (sup which: ExduraHttpServerSupervisor) unwrap
    self assert: httpSup count equals: 1

    // Round-trip a real HTTP request through it.
    baseUrl := "http://localhost:" ++ http port asString
    resp := (HTTPClient
      post: baseUrl ++ "/api/v1/workflows"
      body: (Json
        generate: #{
          "workflowType" => "PassthroughWorkflow",
          "id" => "sup-http-1",
          "args" => #("hello")
        })) unwrap
    self assert: resp status equals: 202
